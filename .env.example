# Клиент (попадает в бандл) — только публичные значения
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable/anon key>
VITE_VAPID_PUBLIC_KEY=<vapid public key>

# Фича-флаги (P1+), по умолчанию выключены
VITE_FF_WEATHER=false
VITE_FF_SENSORS=false
VITE_FF_OFFLINE=false
VITE_FF_PUSH=false
VITE_FF_FARMER=false
VITE_FF_PREMIUM=false
VITE_FF_KYRGYZ=false

# Секреты НЕ сюда, а в Edge Functions: npx supabase secrets set \
#   VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=... VAPID_SUBJECT=mailto:... CRON_SECRET=...
#   IP_HASH_SALT=...   (необязательный «перец» для хэша IP в submit-report; если не задан,
#                       используется service_role-ключ — он и так только на сервере)
